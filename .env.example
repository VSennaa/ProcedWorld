# Copy to .env (never commit .env). Values here are placeholders.

# Deploy target (keep the real host in your ~/.ssh/config, not in the repo)
VPS_HOST=<VPS_HOST>
VPS_USER=deploy

# Server (port range 8100-8199 reserved on the reference host)
SERVER_PORT=8100
ADMIN_PORT=8101

# Database (internal Docker network only; no published port)
POSTGRES_DB=procedworld
POSTGRES_USER=procedworld
POSTGRES_PASSWORD=change-me

# Master key for envelope-encrypting players' API keys (ADR-0002)
KEY_ENCRYPTION_MASTER_KEY=change-me

# T1 decision model via Runware (ADR-0005): typesafe:jev@latest -> runware:laya@1
DECISION_MODEL=typesafe:jev@latest
RUNWARE_API_KEY=

# T2 LLM default provider (players bring their own key; this is for dev only)
LLM_PROVIDER=deepseek
LLM_API_KEY=
